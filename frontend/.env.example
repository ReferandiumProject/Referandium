# Devnet/staging testing only: starting USDC balance for newly created accounts.
# Never set this in production; it would hand out real money to anyone who signs up.
SIGNUP_BONUS_USDC=0

# Devnet/staging testing only: enable the devnet faucet when set to "true".
# Never set this in production; it would let anyone mint themselves real balance.
# DEVNET_FAUCET_ENABLED=false
# DEVNET_FAUCET_DAILY_CAP_USDC=5000

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
